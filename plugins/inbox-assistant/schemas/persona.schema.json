{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/filmacedo/mad-skills/inbox-assistant/persona.schema.json",
  "title": "Inbox Assistant Persona",
  "type": "object",
  "required": ["schema_version", "user_id", "created_at", "updated_at", "mailboxes", "preferences", "output_preferences"],
  "properties": {
    "schema_version": { "const": 1 },
    "user_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "mailboxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "connection", "timezone", "allowed_labels", "allowed_actions"],
        "properties": {
          "address": { "type": "string", "format": "email" },
          "connection": { "type": "string" },
          "timezone": { "type": "string" },
          "account_tag": { "type": "string" },
          "allowed_labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "allowed_actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "label_map": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "preferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/preference" }
    },
    "output_preferences": {
      "type": "object",
      "properties": {
        "timezone": { "type": "string" },
        "voice": { "type": "string" },
        "account_tags": { "type": "boolean" },
        "maximum_focus_items": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "preference": {
      "type": "object",
      "required": ["id", "scope", "action", "digest_visibility", "source", "confidence", "status", "created_at", "updated_at", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope": { "type": "object" },
        "matcher": { "type": "object" },
        "classification": {
          "enum": ["human_correspondence", "events", "content", "updates", "notifications", "transactions", "cold_outreach", "other"]
        },
        "attention": { "enum": ["act_now", "act_later", "fyi", "routine_cleanup", "suspicious"] },
        "action": {
          "enum": ["keep_inbox", "label", "archive", "label_and_archive", "unsubscribe", "report_spam", "block", "notify_only", "suppress_digest"]
        },
        "digest_visibility": { "enum": ["action", "fyi", "cleanup", "hidden"] },
        "source": { "enum": ["explicit_user_feedback", "audit_approval", "imported"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "standing_permission": { "type": "boolean" },
        "status": { "enum": ["active", "proposed", "disabled"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "reason": { "type": "string" },
        "example_message_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
